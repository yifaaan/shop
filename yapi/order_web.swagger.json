{
  "swagger": "2.0",
  "info": {
    "title": "order-web 订单/购物车接口",
    "description": "order_web HTTP 接口。所有接口需在请求头携带 x-token（由 user_web 登录签发）。\n- 购物车：登录用户私有\n- 订单列表角色感知：管理员看全部、普通用户看本人",
    "version": "1.0.0"
  },
  "host": "localhost:8083",
  "basePath": "/o/v1",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "parameters": {
    "XToken": {
      "name": "x-token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "登录令牌（user_web 登录返回）"
    }
  },
  "paths": {
    "/cart": {
      "get": {
        "tags": ["购物车"],
        "summary": "购物车列表",
        "description": "获取当前登录用户的购物车，并通过 goods_srv 补全商品名/图/价。",
        "parameters": [{ "$ref": "#/parameters/XToken" }],
        "responses": {
          "200": {
            "description": "购物车列表",
            "schema": { "$ref": "#/definitions/CartItemList" }
          },
          "401": { "description": "未登录", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "post": {
        "tags": ["购物车"],
        "summary": "添加商品到购物车",
        "description": "先经 goods_srv 校验商品存在且在售，再经 inventory_srv 校验库存充足，最后写入购物车。",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AddCartItemRequest" }
          }
        ],
        "responses": {
          "200": { "description": "添加成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "参数错误/商品已下架/库存不足", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "未登录", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "商品不存在", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/cart/{id}": {
      "put": {
        "tags": ["购物车"],
        "summary": "更新购物车商品（数量/选中状态）",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "购物车记录ID" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdateCartItemRequest" }
          }
        ],
        "responses": {
          "200": { "description": "更新成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "参数错误", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "购物车商品不存在/非本人", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "delete": {
        "tags": ["购物车"],
        "summary": "删除购物车商品",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "购物车记录ID" }
        ],
        "responses": {
          "200": { "description": "删除成功", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "购物车商品不存在/非本人", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["订单"],
        "summary": "订单列表（角色感知）",
        "description": "管理员：默认查全部，可用 user_id 按用户过滤；普通用户：只看本人订单（忽略 user_id）。",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "user_id", "in": "query", "required": false, "type": "integer", "description": "按用户过滤（仅管理员生效，0=全部）" },
          { "name": "status", "in": "query", "required": false, "type": "integer", "description": "订单状态过滤（0=不过滤）：1-待支付 2-已支付 3-已取消/超时关闭 4-交易创建 5-交易结束" },
          { "name": "p", "in": "query", "required": false, "type": "integer", "default": 1, "description": "页码" },
          { "name": "pnum", "in": "query", "required": false, "type": "integer", "default": 10, "description": "每页数量" }
        ],
        "responses": {
          "200": { "description": "订单列表", "schema": { "$ref": "#/definitions/OrderList" } },
          "401": { "description": "未登录", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "post": {
        "tags": ["订单"],
        "summary": "创建订单",
        "description": "商品取自购物车中已选中(checked=true)的项；自动拉取商品价格、扣减库存、写订单、清购物车。库存/事务失败会自动归还库存。",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateOrderRequest" }
          }
        ],
        "responses": {
          "200": { "description": "订单详情", "schema": { "$ref": "#/definitions/Order" } },
          "400": { "description": "参数错误/购物车无选中商品", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "商品不存在或已下架", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "扣减库存/创建订单失败", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["订单"],
        "summary": "订单详情",
        "description": "按 id 查询订单（含商品明细）。带 userId 归属校验：非本人订单返回 404。",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "订单ID" }
        ],
        "responses": {
          "200": { "description": "订单详情", "schema": { "$ref": "#/definitions/Order" } },
          "404": { "description": "订单不存在/非本人", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "delete": {
        "tags": ["订单"],
        "summary": "删除订单",
        "description": "按 id 删除订单。先做 userId 归属校验，非本人订单返回 404（不泄露存在性）。",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "订单ID" }
        ],
        "responses": {
          "200": { "description": "删除成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "invalid id", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "未登录", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "订单不存在/非本人", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/orders/status": {
      "put": {
        "tags": ["订单"],
        "summary": "更新订单状态",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdateOrderStatusRequest" }
          }
        ],
        "responses": {
          "200": { "description": "更新成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "非法状态码", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "订单不存在", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    }
  },
  "definitions": {
    "Message": {
      "type": "object",
      "properties": {
        "msg": { "type": "string" }
      }
    },
    "CartItem": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "购物车记录ID" },
        "goods_id": { "type": "integer", "description": "商品ID" },
        "goods_name": { "type": "string", "description": "商品名（goods_srv 补全）" },
        "goods_image": { "type": "string", "description": "商品封面图（goods_srv 补全）" },
        "goods_price": { "type": "number", "format": "float", "description": "本店价（goods_srv 补全）" },
        "num": { "type": "integer", "description": "数量" },
        "checked": { "type": "boolean", "description": "是否选中" }
      }
    },
    "CartItemList": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "data": { "type": "array", "items": { "$ref": "#/definitions/CartItem" } }
      }
    },
    "AddCartItemRequest": {
      "type": "object",
      "required": ["goods_id", "num"],
      "properties": {
        "goods_id": { "type": "integer" },
        "num": { "type": "integer", "minimum": 1 },
        "checked": { "type": "boolean" }
      }
    },
    "UpdateCartItemRequest": {
      "type": "object",
      "required": ["num"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "checked": { "type": "boolean" }
      }
    },
    "OrderItem": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "order_id": { "type": "integer" },
        "goods_id": { "type": "integer" },
        "goods_name": { "type": "string" },
        "goods_image": { "type": "string" },
        "goods_price": { "type": "number", "format": "float" },
        "num": { "type": "integer" }
      }
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "order_sn": { "type": "string", "description": "订单号：年月日时分秒+用户ID+2位随机" },
        "user_id": { "type": "integer" },
        "address": { "type": "string" },
        "name": { "type": "string", "description": "收货人" },
        "mobile": { "type": "string" },
        "post": { "type": "string", "description": "留言" },
        "status": { "type": "integer", "description": "1-待支付 2-已支付 3-已取消/超时关闭 4-交易创建 5-交易结束" },
        "pay_type": { "type": "integer", "description": "1-微信 2-支付宝" },
        "total": { "type": "number", "format": "float", "description": "商品总金额（不含运费）" },
        "post_fee": { "type": "number", "format": "float", "description": "运费" },
        "add_time": { "type": "integer", "format": "int64", "description": "下单时间(unix)" },
        "order_goods": { "type": "array", "items": { "$ref": "#/definitions/OrderItem" } }
      }
    },
    "OrderList": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "data": { "type": "array", "items": { "$ref": "#/definitions/Order" } }
      }
    },
    "CreateOrderRequest": {
      "type": "object",
      "required": ["address", "name", "mobile", "pay_type"],
      "properties": {
        "address": { "type": "string" },
        "name": { "type": "string", "description": "收货人" },
        "mobile": { "type": "string", "description": "11位手机号" },
        "post": { "type": "string", "description": "留言" },
        "pay_type": { "type": "integer", "enum": [1, 2], "description": "1-微信 2-支付宝" },
        "post_fee": { "type": "number", "format": "float", "description": "运费" }
      }
    },
    "UpdateOrderStatusRequest": {
      "type": "object",
      "required": ["order_sn", "status"],
      "properties": {
        "order_sn": { "type": "string" },
        "status": { "type": "integer", "enum": [1, 2, 3, 4, 5], "description": "目标状态" }
      }
    }
  }
}
