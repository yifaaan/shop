          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/UpdateCategoryForm" } }
        ],
        "responses": {
          "200": { "description": "更新成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "invalid id/参数错误", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "未登录/登录已过期", "schema": { "$ref": "#/definitions/Message" } },
          "403": { "description": "无管理权限", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "分类不存在", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "delete": {
        "tags": ["分类"],
        "summary": "删除分类（管理员）",
