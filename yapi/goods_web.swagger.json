{
  "swagger": "2.0",
  "info": {
    "title": "goods-web 商品/分类/品牌/轮播图接口",
    "description": "goods_web HTTP 接口。\n- 浏览类接口（GET）公开，无需 x-token\n- 管理类接口（POST/PUT/DELETE）需 x-token 且为管理员（AuthorityId==2），否则 401/403\n- 响应字段大小写按代码原样：商品列表/详情、分类列表为 snake_case；新建商品、品牌、轮播图、分类品牌为 proto 生成 camelCase",
    "version": "1.0.0"
  },
  "host": "localhost:8082",
  "basePath": "/g/v1",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "parameters": {
    "XToken": {
      "name": "x-token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "管理员令牌（user_web 登录，AuthorityId==2）"
    }
  },
  "paths": {
    "/goods": {
      "get": {
        "tags": ["商品"],
        "summary": "商品列表",
        "description": "分页+多条件筛选商品列表。",
        "parameters": [
          { "name": "pmin", "in": "query", "required": false, "type": "integer", "default": 0, "description": "最低价" },
          { "name": "pmax", "in": "query", "required": false, "type": "integer", "default": 0, "description": "最高价" },
          { "name": "ih", "in": "query", "required": false, "type": "integer", "default": 0, "enum": [0, 1], "description": "是否热门，1=true" },
          { "name": "in", "in": "query", "required": false, "type": "integer", "default": 0, "enum": [0, 1], "description": "是否新品，1=true" },
          { "name": "it", "in": "query", "required": false, "type": "integer", "default": 0, "enum": [0, 1], "description": "是否 tab，1=true" },
          { "name": "c", "in": "query", "required": false, "type": "integer", "default": 0, "description": "顶级分类ID" },
          { "name": "p", "in": "query", "required": false, "type": "integer", "default": 1, "description": "页码" },
          { "name": "pnum", "in": "query", "required": false, "type": "integer", "default": 10, "description": "每页数量" },
          { "name": "q", "in": "query", "required": false, "type": "string", "default": "", "description": "关键词" },
          { "name": "b", "in": "query", "required": false, "type": "integer", "default": 0, "description": "品牌ID" }
        ],
        "responses": {
          "200": { "description": "商品列表", "schema": { "$ref": "#/definitions/GoodsList" } },
          "400": { "description": "参数错误", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "未找到", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "post": {
        "tags": ["商品"],
        "summary": "新建商品（管理员）",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CreateGoodsForm" } }
        ],
        "responses": {
          "200": { "description": "新建的商品（camelCase）", "schema": { "$ref": "#/definitions/CreateGoodsResponse" } },
          "400": { "description": "参数错误", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "未登录/登录已过期", "schema": { "$ref": "#/definitions/Message" } },
          "403": { "description": "无管理权限", "schema": { "$ref": "#/definitions/Message" } },
          "409": { "description": "已存在", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/goods/{id}": {
      "get": {
        "tags": ["商品"],
        "summary": "商品详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "商品ID" }
        ],
        "responses": {
          "200": { "description": "商品详情（snake_case）", "schema": { "$ref": "#/definitions/Goods" } },
          "400": { "description": "invalid id", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "商品不存在", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "put": {
        "tags": ["商品"],
        "summary": "更新商品（管理员）",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "商品ID" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/UpdateGoodsForm" } }
        ],
        "responses": {
          "200": { "description": "更新成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "invalid id/参数错误", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "未登录/登录已过期", "schema": { "$ref": "#/definitions/Message" } },
          "403": { "description": "无管理权限", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "商品不存在", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      },
      "delete": {
        "tags": ["商品"],
        "summary": "删除商品（管理员）",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "id", "in": "path", "required": true, "type": "integer", "description": "商品ID" }
        ],
        "responses": {
          "200": { "description": "删除成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "invalid id", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "未登录/登录已过期", "schema": { "$ref": "#/definitions/Message" } },
          "403": { "description": "无管理权限", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "商品不存在", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "服务器错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/category": {
      "get": {
        "tags": ["分类"],
        "summary": "全部分类（树）",
        "description": "返回完整分类树。data 为后端原样回传的 JSON 树字符串。",
