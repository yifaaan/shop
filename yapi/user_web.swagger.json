{
  "swagger": "2.0",
  "info": {
    "title": "user-web 用户/鉴权接口",
    "description": "user_web HTTP 接口。\n- 注册/登录/验证码/短信为公开接口，无需 x-token\n- 用户列表为管理员接口（x-token 且 AuthorityId==2）\n- JWT 通过响应体的 token 返回，后续请求以 x-token 携带；HS256，30 天有效期，issuer=shop",
    "version": "1.0.0"
  },
  "host": "localhost:8081",
  "basePath": "/u/v1",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "parameters": {
    "XToken": {
      "name": "x-token",
      "in": "header",
      "required": true,
      "type": "string",
      "description": "登录令牌（注册/登录接口返回的 token）"
    }
  },
  "paths": {
    "/user/list": {
      "get": {
        "tags": ["用户"],
        "summary": "用户列表（管理员）",
        "description": "分页查询全部用户。需 x-token 且为管理员（AuthorityId==2），否则 401/403。",
        "parameters": [
          { "$ref": "#/parameters/XToken" },
          { "name": "pn", "in": "query", "required": false, "type": "integer", "default": 0, "description": "页码" },
          { "name": "psize", "in": "query", "required": false, "type": "integer", "default": 10, "description": "每页数量" }
        ],
        "responses": {
          "200": {
            "description": "用户数组",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/UserResponse" } }
          },
          "401": { "description": "未登录/登录已过期", "schema": { "$ref": "#/definitions/Message" } },
          "403": { "description": "非管理员，无权限", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/user/pwd_login": {
      "post": {
        "tags": ["用户"],
        "summary": "密码登录",
        "description": "校验图形验证码后按手机号+密码登录，签发 JWT。验证码由 /u/v1/base/captcha 获取。",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/PasswordLoginForm" }
          }
        ],
        "responses": {
          "200": { "description": "登录成功", "schema": { "$ref": "#/definitions/LoginResponse" } },
          "400": { "description": "参数错误/验证码错误", "schema": { "$ref": "#/definitions/Message" } },
          "401": { "description": "密码错误", "schema": { "$ref": "#/definitions/Message" } },
          "404": { "description": "用户不存在", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "token 签发失败/服务错误", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/user/register": {
      "post": {
        "tags": ["用户"],
        "summary": "注册",
        "description": "校验短信验证码后创建用户（默认昵称为手机号），签发 JWT。短信由 /u/v1/base/send_sms 发送。",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/RegisterForm" }
          }
        ],
        "responses": {
          "200": { "description": "注册成功", "schema": { "$ref": "#/definitions/LoginResponse" } },
          "400": { "description": "参数错误/验证码错误/验证码已过期", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "验证码服务不可用/token 签发失败/创建用户失败", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/base/captcha": {
      "get": {
        "tags": ["基础"],
        "summary": "图形验证码",
        "description": "生成 5 位数字图形验证码，返回 captcha_id 与 base64 图片。captcha_id 在登录时回传。",
        "responses": {
          "200": { "description": "验证码", "schema": { "$ref": "#/definitions/CaptchaResponse" } },
          "500": { "description": "生成失败", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    },
    "/base/send_sms": {
      "post": {
        "tags": ["基础"],
        "summary": "发送短信验证码",
        "description": "向手机号发送短信验证码（阿里云 dypnsapi）。同一手机号 60 秒内仅可发送一次。type 当前服务端未使用，验证后忽略。",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/SendSmsForm" }
          }
        ],
        "responses": {
          "200": { "description": "发送成功", "schema": { "$ref": "#/definitions/Message" } },
          "400": { "description": "参数错误", "schema": { "$ref": "#/definitions/Message" } },
          "429": { "description": "请勿频繁发送验证码", "schema": { "$ref": "#/definitions/Message" } },
          "500": { "description": "验证码服务不可用/存储失败", "schema": { "$ref": "#/definitions/Message" } },
          "502": { "description": "短信发送失败/未取到验证码", "schema": { "$ref": "#/definitions/Message" } }
        }
      }
    }
  },
  "definitions": {
    "Message": {
      "type": "object",
      "properties": {
        "msg": { "type": "string" }
      }
    },
    "UserResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "用户ID" },
        "name": { "type": "string", "description": "昵称（json tag 为 name）" },
        "mobile": { "type": "string", "description": "手机号" },
        "birthday": { "type": "string", "description": "生日，格式 YYYY-MM-DD" },
        "gender": { "type": "string", "description": "性别" }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "用户ID" },
        "nickname": { "type": "string", "description": "昵称" },
        "token": { "type": "string", "description": "HS256 JWT，30 天有效期，issuer=shop" }
      }
    },
    "PasswordLoginForm": {
      "type": "object",
      "required": ["mobile", "password", "captcha", "captcha_id"],
      "properties": {
        "mobile": { "type": "string", "description": "11位手机号" },
        "password": { "type": "string", "minLength": 6, "maxLength": 15 },
        "captcha": { "type": "string", "description": "5位图形验证码" },
        "captcha_id": { "type": "string", "description": "/base/captcha 返回的 captcha_id" }
      }
    },
    "RegisterForm": {
      "type": "object",
      "required": ["mobile", "password", "code"],
      "properties": {
        "mobile": { "type": "string", "description": "11位手机号" },
        "password": { "type": "string", "minLength": 6, "maxLength": 15 },
        "code": { "type": "string", "description": "短信验证码" }
      }
    },
    "CaptchaResponse": {
      "type": "object",
      "properties": {
        "captcha_id": { "type": "string", "description": "登录时回传的验证码ID" },
        "picPath": { "type": "string", "description": "base64 图片（data URI）" }
      }
    },
    "SendSmsForm": {
      "type": "object",
      "required": ["mobile", "type"],
      "properties": {
        "mobile": { "type": "string", "description": "11位手机号" },
        "type": { "type": "integer", "enum": [1, 2], "description": "1-注册 2-登录（服务端当前未使用）" }
      }
    }
  }
}